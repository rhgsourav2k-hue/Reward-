{
  "version": 2,
  "builds": [
    {
      "src": "api/register.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/register",
      "dest": "/api/register.py"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
